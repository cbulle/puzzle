<div id="intro" aria-hidden="true">
  <svg viewBox="0 0 200 230">
    <defs>
      <mask id="intro-mask">
        <rect width="200" height="230" fill="#fff" />
        <path transform="translate(100 128) rotate(45) scale(1.5)" d="M-30 -30H-9C-9 -42 9 -42 9 -30H30V-9C42 -9 42 9 30 9V30H9C9 18 -9 18 -9 30H-30V9C-18 9 -18 -9 -30 -9Z" />
      </mask>
    </defs>
    <g class="leaf">
      <path fill="#f3ecdc" mask="url(#intro-mask)" d="M100 10C112 30 118 40 130 50C148 62 150 80 156 100C172 108 176 130 168 150C160 178 130 200 102 204L104 226H98L98 204C70 200 40 178 32 150C24 130 28 108 44 100C50 80 52 62 70 50C82 40 88 30 100 10Z" />
    </g>
    <g transform="translate(100 128)">
      <g class="piece">
        <path fill="#d9b56a" transform="rotate(45) scale(1.5)" d="M-30 -30H-9C-9 -42 9 -42 9 -30H30V-9C42 -9 42 9 30 9V30H9C9 18 -9 18 -9 30H-30V9C-18 9 -18 -9 -30 -9Z" />
      </g>
    </g>
  </svg>
  <p class="ititle">Brasserie Puzzle</p>
  <button id="skip" type="button">Passer</button>
</div>

<script is:inline>
  const intro = document.querySelector('#intro');
  const skip = document.querySelector('#skip');
  let seen = false;
  try { seen = sessionStorage.getItem('intro') === '1'; } catch { /* rien */ }
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (intro instanceof HTMLElement) {
    if (seen || reduced) {
      intro.remove();
    } else {
      document.documentElement.classList.add('intro-on');
      let done = false;
      const close = () => {
        if (done) return;
        done = true;
        try { sessionStorage.setItem('intro', '1'); } catch { /* rien */ }
        intro.classList.add('out');
        document.documentElement.classList.remove('intro-on');
        window.setTimeout(() => intro.remove(), 700);
      };
      skip?.addEventListener('click', close);
      intro.addEventListener('click', close);
      window.setTimeout(close, 3600);
    }
  }
</script>
