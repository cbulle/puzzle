---
const { beer, large = false } = Astro.props;
const imageClass = large ? 'pb' : 'pp';
const fallbackClass = large ? 'perso big portrait-fallback' : 'perso portrait-fallback';
---
<span class="portrait" data-portrait>
  <img
    class={imageClass}
    src={`/images/bieres/${beer.slug}.png`}
    alt=""
    width={large ? 200 : 120}
    height={large ? 200 : 120}
    loading={large ? 'eager' : 'lazy'}
  />
  <span class={fallbackClass} data-portrait-fallback hidden aria-hidden="true">{beer.name[0]}</span>
</span>
