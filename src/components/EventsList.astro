---
const { max = 50 } = Astro.props;
---
<div class="events" data-event-list data-max={max}>
  <p role="status" data-events-loading>Chargement de l’agenda…</p>
  <p hidden data-events-empty>Pas de date annoncée pour le moment. Suivez-nous sur <a href="https://www.facebook.com/brasseriepuzzle" rel="noopener noreferrer">Facebook</a> pour être prévenus.</p>
  <ol class="ev-list" data-events-list></ol>
</div>

<script>
  import '../scripts/events.js';
</script>
