---
import Actions from '../components/Actions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const description = 'Contacter la Brasserie Puzzle à Lent (01240), dans l’Ain : adresse, téléphone et horaires pour visiter la brasserie artisanale.';
---
<BaseLayout title="Contact et accès à la brasserie | Brasserie Puzzle, Lent" description={description} canonicalPath="/contact.html">
  <main class="wrap">
    <h1>Nous contacter</h1>
    <p class="lead">Une question, une commande, une visite&nbsp;? Le plus simple est d’appeler.</p>
    <Actions email />
    <div class="two contact-info">
      <dl class="facts">
        <dt>Adresse</dt><dd>341 route de Bresse<br />01240 Lent</dd>
        <dt>Vente sur place</dt><dd>Samedi, 9 h – 12 h</dd>
        <dt>En semaine</dt><dd>Sur rendez-vous</dd>
      </dl>
      <div>
        <h2>Plan d’accès</h2>
        <div class="map" data-map>
          <button class="btn" type="button" data-show-map>Afficher la carte</button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const map = document.querySelector('[data-map]');
  const showMap = document.querySelector('[data-show-map]');
  showMap?.addEventListener('click', () => {
    if (!(map instanceof HTMLElement)) return;
    const frame = document.createElement('iframe');
    frame.src = 'https://www.google.com/maps?q=341+route+de+Bresse+01240+Lent&output=embed';
    frame.title = 'Plan d’accès à la Brasserie Puzzle, 341 route de Bresse à Lent';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    map.replaceChildren(frame);
  });
</script>
