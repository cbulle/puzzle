---
import EventsList from '../components/EventsList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const description = 'Les prochains marchés, portes ouvertes et rendez-vous de la Brasserie Puzzle dans la Dombes et l’Ain.';
---
<BaseLayout title="Agenda | Brasserie Puzzle, Lent" description={description} canonicalPath="/evenements.html">
  <main class="wrap">
    <h1>Agenda</h1>
    <p class="lead">Où trouver les bières Puzzle dans les semaines à venir.</p>
    <EventsList />
  </main>
</BaseLayout>
