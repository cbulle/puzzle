# Set this before the production build once the public domain is selected.
# Example: PUBLIC_SITE_URL=https://brasseriepuzzle.fr
PUBLIC_SITE_URL=

# Firebase browser configuration. Keep real values in the ignored .env file.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
